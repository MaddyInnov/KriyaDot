<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera: QR pairing scan only. Asked at runtime with an in-app rationale;
         denied => manual host/port/token entry remains available. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <!-- Network access to the KriyaDot instance on your LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Push notifications for "done" / "needs you" alerts (Android 13+ asks
         at runtime; the app works without it via the WebSocket). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MVP talks to the PC over plain HTTP on the LAN (no TLS yet).
         usesCleartextTraffic is REQUIRED for this to work; switch the app
         and server to HTTPS/WSS before any use outside a trusted LAN. -->
    <application
        android:label="KriyaDot Companion"
        android:theme="@style/Theme.KriyaDot"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- zxing-android-embedded declares its CaptureActivity in its own
             manifest; it is merged in automatically, no entry needed here. -->

        <!-- FCM data messages: decrypted locally, never contain plaintext. -->
        <service
            android:name=".core.KriyaDotMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
