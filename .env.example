# SPDX-License-Identifier: Apache-2.0
# Copy to .env and fill in. At minimum you need ONE provider key.
# Get a free Groq key: https://console.groq.com/keys

# --- Providers (keys are NEVER logged or written to the audit log) ---
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OMNIRUSH_API_KEY=

# --- Runtime ---
PORT=4000
DATA_DIR=./data          # SQLite DBs + providers.local.json (created automatically)
SEED_DIR=./seed          # bots, skills, workflows, mcp config
PROVIDERS_FILE=          # default: <DATA_DIR>/providers.local.json (0600, AES-256-GCM)
WORKSPACE_DIR=           # default: <DATA_DIR>/workspace — sandbox root for read_file/write_file/run_command tools
# --- Optional ---
# Public base URL for hosted/phone pairing (else LAN-only). Example: https://sarviq.example.com
SARVIQ_PUBLIC_URL=
# Cap session history kept per chat (prevents context blowout). Default 100.
SESSION_HISTORY_LIMIT=
# Web dev only: API base the Next.js UI calls. Default http://localhost:4000
NEXT_PUBLIC_API_URL=
