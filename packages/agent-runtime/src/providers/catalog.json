{
  "providers": {
    "anthropic": {
      "api": "anthropic",
      "baseUrl": "https://api.anthropic.com/v1",
      "envKey": "ANTHROPIC_API_KEY",
      "id": "anthropic",
      "models": [
        {
          "default": true,
          "id": "claude-3-5-sonnet-latest",
          "name": "Claude 3.5 Sonnet",
          "contextLength": 200000
        },
        {
          "id": "claude-3-5-haiku-latest",
          "name": "Claude 3.5 Haiku",
          "contextLength": 200000
        }
      ],
      "name": "Anthropic"
    },
    "groq": {
      "api": "openai-compatible",
      "baseUrl": "https://api.groq.com/openai/v1",
      "envKey": "GROQ_API_KEY",
      "id": "groq",
      "models": [
        {
          "default": true,
          "id": "gpt-oss-120b",
          "name": "GPT-OSS 120B",
          "contextLength": 131072
        },
        {
          "id": "gpt-oss-20b",
          "name": "GPT-OSS 20B",
          "contextLength": 131072
        },
        {
          "id": "groq/compound",
          "name": "Groq Compound",
          "contextLength": 131072
        },
        {
          "id": "groq/compound-mini",
          "name": "Groq Compound Mini",
          "contextLength": 131072
        }
      ],
      "name": "Groq"
    },
    "omnirush": {
      "api": "openai-compatible",
      "baseUrl": "",
      "byo": true,
      "envKey": "OMNIRUSH_API_KEY",
      "id": "omnirush",
      "liveModels": false,
      "models": [],
      "name": "OmniRush (bring your own)",
      "notes": "Bring-your-own preset. Paste YOUR OWN OmniRush API key/token from your own OmniRush account \u2014 never a shared or pooled key. Set the base URL from your OmniRush app/account; no endpoint is pre-configured."
    },
    "openai": {
      "api": "openai-compatible",
      "baseUrl": "https://api.openai.com/v1",
      "envKey": "OPENAI_API_KEY",
      "id": "openai",
      "models": [
        {
          "default": true,
          "id": "gpt-4o-mini",
          "name": "GPT-4o mini",
          "contextLength": 128000
        },
        {
          "id": "gpt-4o",
          "name": "GPT-4o",
          "contextLength": 128000
        }
      ],
      "name": "OpenAI"
    },
    "opencode-zen": {
      "api": "openai-compatible",
      "baseUrl": "https://opencode.ai/zen/v1",
      "envKey": "OPENCODE_ZEN_API_KEY",
      "byo": true,
      "liveModels": true,
      "models": [
        {
          "id": "big-pickle",
          "name": "Big Pickle",
          "default": true,
          "free": true
        },
        {
          "id": "jev-1.13-free",
          "name": "Jev 1.13",
          "free": true
        },
        {
          "id": "exo-free",
          "name": "Exo",
          "free": true
        },
        {
          "id": "muse-spark-1.3-contributor-free",
          "name": "Muse Spark 1.3",
          "free": true
        },
        {
          "id": "muse-spark-1.2-contributor-free",
          "name": "Muse Spark 1.2",
          "free": true
        },
        {
          "id": "mimo-v2.6-flash-free",
          "name": "MiMo V2.6 Flash",
          "free": true
        },
        {
          "id": "space-bunny-free",
          "name": "Space Bunny",
          "free": true
        },
        {
          "id": "longcat-2.5-preview-free",
          "name": "LongCat 2.5 Preview",
          "free": true
        },
        {
          "id": "step-5-preview-free",
          "name": "Step 5 Preview",
          "free": true
        },
        {
          "id": "ling-3.0-flash-fin-free",
          "name": "Ling 3.0 Flash Fin",
          "free": true
        },
        {
          "id": "nemotron-3-ultra-free",
          "name": "Nemotron 3 Ultra",
          "free": true
        },
        {
          "id": "nemotron-3.5-lightning-free",
          "name": "Nemotron 3.5 Lightning",
          "free": true
        },
        {
          "id": "ling-3.1-flash-free",
          "name": "Ling 3.1 Flash",
          "free": true
        }
      ],
      "id": "opencode-zen",
      "name": "OpenCode Zen (bring your own)",
      "notes": "Bring-your-own preset. Sign up at opencode.ai/zen for your own API key (no card needed for the free rotation). Free roster checked 2026-10-09 \u2014 it rotates, so the live /models fetch is authoritative; only -free models are zero-cost, most other Zen models are pay-as-you-go."
    },
    "openrouter": {
      "api": "openai-compatible",
      "baseUrl": "https://openrouter.ai/api/v1",
      "envKey": "OPENROUTER_API_KEY",
      "extraHeaders": {
        "HTTP-Referer": "https://localhost",
        "X-Title": "MVP All-in-One AI Agent Platform"
      },
      "id": "openrouter",
      "liveModels": true,
      "models": [],
      "name": "OpenRouter"
    },
    "claude-subscription": {
      "id": "claude-subscription",
      "name": "Claude subscription (Claude Code login)",
      "api": "anthropic",
      "baseUrl": "https://api.anthropic.com/v1",
      "envKey": "CLAUDE_SUBSCRIPTION_TOKEN",
      "bridge": "claude",
      "models": [
        {
          "id": "claude-opus-4-1",
          "name": "Claude Opus 4.1",
          "default": true
        },
        {
          "id": "claude-sonnet-4-5",
          "name": "Claude Sonnet 4.5"
        },
        {
          "id": "claude-haiku-4-5",
          "name": "Claude Haiku 4.5"
        }
      ],
      "notes": "Uses YOUR Claude Code CLI login (~/.claude/.credentials.json) \u2014 no API key needed. Shown only when the CLI is detected; requires your explicit Connect consent. Token is read at request time and never stored or logged.",
      "liveModels": true
    },
    "codex-subscription": {
      "id": "codex-subscription",
      "name": "ChatGPT subscription (Codex CLI login)",
      "api": "openai-compatible",
      "baseUrl": "https://api.openai.com/v1",
      "envKey": "CODEX_SUBSCRIPTION_TOKEN",
      "bridge": "codex",
      "models": [
        {
          "id": "gpt-5",
          "name": "GPT-5",
          "default": true
        },
        {
          "id": "gpt-5-mini",
          "name": "GPT-5 mini"
        },
        {
          "id": "gpt-5-nano",
          "name": "GPT-5 nano"
        },
        {
          "id": "gpt-4.1",
          "name": "GPT-4.1"
        },
        {
          "id": "gpt-4.1-mini",
          "name": "GPT-4.1 mini"
        },
        {
          "id": "o3",
          "name": "o3"
        },
        {
          "id": "o4-mini",
          "name": "o4-mini"
        }
      ],
      "notes": "Uses YOUR Codex CLI login (~/.codex/auth.json) \u2014 no API key needed. Shown only when the CLI is detected; requires your explicit Connect consent. Token is read at request time and never stored or logged.",
      "liveModels": true
    },
    "ollama": {
      "api": "ollama",
      "baseUrl": "http://localhost:11434",
      "envKey": "OLLAMA_HOST",
      "id": "ollama",
      "local": true,
      "liveModels": true,
      "models": [],
      "name": "Ollama (local)",
      "notes": "Fully local models via Ollama \u2014 no API key needed, ever. Install from https://ollama.com/download, pull a model (e.g. \"ollama pull llama3.1\"), and it just works. Set OLLAMA_HOST if Ollama runs on another host."
    },
    "opencode-subscription": {
      "id": "opencode-subscription",
      "name": "OpenCode subscription (CLI login)",
      "api": "openai-compatible",
      "baseUrl": "https://opencode.ai/zen/v1",
      "envKey": "OPENCODE_SUBSCRIPTION_TOKEN",
      "bridge": "opencode",
      "liveModels": true,
      "models": [
        {
          "id": "big-pickle",
          "name": "Big Pickle",
          "default": true
        }
      ],
      "notes": "Uses YOUR OpenCode CLI login (~/.local/share/opencode/auth.json) \u2014 no API key needed. Shown only when the CLI is detected; requires your explicit Connect consent. Token is read at request time and never stored or logged."
    }
  }
}